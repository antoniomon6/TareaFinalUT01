<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icono"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icono"
        android:supportsRtl="true"
        android:theme="@style/Theme.TareaFinalUT01">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.tareafinalut01.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".Actividades.SettingsActivity"
            android:exported="false"
            android:label="@string/titulo_activity_settings" />
        <activity
            android:name=".Actividades.CrearTareaActivity"
            android:exported="false" />
        <activity
            android:name=".Actividades.ListadoTareasActivity"
            android:exported="false" />
        <activity
            android:name=".Actividades.DescripcionActivity"
            android:exported="false" />
        <activity
            android:name=".Actividades.EstadisticasActivity"
            android:exported="false" />
        <activity
            android:name=".Actividades.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>