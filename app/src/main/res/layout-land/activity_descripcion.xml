<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/colorTertiary"
    tools:context=".Actividades.DescripcionActivity">

    <!-- Lado izquierdo: Título y Descripción -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_titulo_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la Tarea"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnTertiary"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:id="@+id/sv_descripcion"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_descripcion_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción larga de la tarea..."
                android:textSize="16sp"
                android:textColor="?attr/colorOnTertiary" />
        </ScrollView>
    </LinearLayout>

    <!-- Divisor visual opcional -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:background="?attr/colorOnTertiary"
        android:alpha="0.2"/>

    <!-- Lado derecho: Adjuntos -->
    <TableLayout
        android:id="@+id/tl_adjuntos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:stretchColumns="1"
        android:layout_gravity="center_vertical">

        <TableRow android:padding="4dp" android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iv_icon_doc"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/documento"
                app:tint="?attr/colorMultimediaIcon" />
            <TextView
                android:id="@+id/tv_name_doc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ningún documento"
                android:textSize="14sp"
                android:textColor="?attr/colorOnTertiary" />
        </TableRow>

        <TableRow android:padding="4dp" android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iv_icon_img"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/imagen"
                app:tint="?attr/colorMultimediaIcon" />
            <TextView
                android:id="@+id/tv_name_img"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ninguna imagen"
                android:textSize="14sp"
                android:textColor="?attr/colorOnTertiary" />
        </TableRow>

        <TableRow android:padding="4dp" android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iv_icon_aud"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/audio"
                app:tint="?attr/colorMultimediaIcon" />
            <TextView
                android:id="@+id/tv_name_aud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ningún audio"
                android:textSize="14sp"
                android:textColor="?attr/colorOnTertiary" />
        </TableRow>

        <TableRow android:padding="4dp" android:gravity="center_vertical">
            <ImageView
                android:id="@+id/iv_icon_vid"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/video"
                app:tint="?attr/colorMultimediaIcon" />
            <TextView
                android:id="@+id/tv_name_vid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ningún vídeo"
                android:textSize="14sp"
                android:textColor="?attr/colorOnTertiary" />
        </TableRow>
    </TableLayout>

</LinearLayout>